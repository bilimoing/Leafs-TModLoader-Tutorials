{
  "name": "leaf-tutorial-offline",
  "version": "2.0.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.bilimoing.leaftutorials",
    "productName": "LeafTutorials",
    "files": [
      "main.cjs",
      "package.json",
      "icons/*"
    ],
    "extraResources": [
      {
        "from": "../site",
        "to": "site"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "LeafTutorials-Windows-x64-Setup.exe",
      "icon": "icons/leaf.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "叶子的 tModLoader 教程",
      "uninstallDisplayName": "叶子的 tModLoader 教程（离线版）",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "installerIcon": "icons/leaf.ico",
      "uninstallerIcon": "icons/leaf.ico"
    }
  }
}