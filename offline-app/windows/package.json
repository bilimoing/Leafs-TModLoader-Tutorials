{
  "name": "leaf-tutorial-offline",
  "version": "1.0.0",
  "private": true,
  "main": "main.cjs",
  "scripts": { "start": "electron .", "package": "electron-builder --win zip --x64" },
  "devDependencies": { "electron": "^42.0.0", "electron-builder": "^26.0.12" },
  "build": {
    "appId": "io.github.bilimoing.leaftutorials",
    "productName": "LeafTutorials",
    "files": ["main.cjs", "package.json"],
    "extraResources": [{ "from": "../site", "to": "site" }],
    "win": { "target": "zip", "artifactName": "LeafTutorials-Windows-x64.zip" }
  }
}
