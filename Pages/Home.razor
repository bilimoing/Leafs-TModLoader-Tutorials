@page "/"
@using 叶子的TModLoader教程.Services
@inject TutorialLibrary Library
@inject IJSRuntime JS
<PageTitle>@(Current?.Title ?? "叶子的 tModLoader 教程")</PageTitle>
<div class='top-search'><label class='search-box'>⌕ <input aria-label='搜索教程全文' placeholder='搜索教程、函数、关键词…' @bind='query' @bind:event='oninput' /><kbd>/</kbd></label></div>
<main class='main-content'>
@if(!string.IsNullOrWhiteSpace(query)) { var results = Library.Search(query).ToList(); <div class='eyebrow'>搜索教程</div><h1>找到 @results.Count 篇相关教程</h1><p>全文搜索「@query」</p><button class='text-button' @onclick='() => query = string.Empty'>清除搜索，返回阅读</button><div class='search-results'>@foreach(var result in results) { <a href='@result.Url' @onclick='() => query = string.Empty'><small>@result.Group</small><h2>@result.Title ↗</h2><p>@Snippet(result)</p></a> }@if(results.Count == 0) { <p>没有找到相关教程，试试“弹幕”或“绘制”。</p> }</div> }
else if(Current is not null) { <div class='article-layout'><div class='article-column'><div class='breadcrumb'><a href='.'>教程首页</a> / @Current.Group</div><header class='article-header'><div class='eyebrow'>TMODLOADER 开发笔记</div><h1>@Current.Title</h1><div class='article-meta'>约 @Current.Minutes 分钟阅读 · .NET 10 / TML 1.4.5</div></header><article class='markdown' @key='Current.Title'>@((MarkupString)Current.Html)</article><div class='reading-help'>遇到问题？带上报错信息和相关代码，到 QQ 群 921853970 一起讨论。</div><nav class='article-pagination' aria-label='相邻教程'>@if(Neighbor(-1) is Tutorial previous) { <a href='@previous.Url'><small>← 上一篇</small><strong>@previous.Title</strong></a> } @if(Neighbor(1) is Tutorial next) { <a href='@next.Url'><small>下一篇 →</small><strong>@next.Title</strong></a> }</nav></div></div> }
else if(!string.IsNullOrEmpty(Article)) { <h1>这篇教程暂未收录</h1><p>请检查链接，或通过顶部搜索寻找你需要的教程。</p><a href='.'>返回首页</a> }
else {
<section class='hero'><div class='eyebrow'><span class='status-dot'></span> 面向 tModLoader 1.4.5 的中文教程</div><h1>让你的想法，<br />成为游戏的一部分<span>。</span></h1><p>从搭建环境到自定义物品，从弹幕运动到绘制特效。<br />跟着叶子，一步一步走进泰拉瑞亚模组开发。</p><div class='hero-actions'><a class='primary-button' href='?article=教程前言'>开始学习 →</a><a class='secondary-button' href='?article=主页'>浏览全部资源 ↗</a></div><div class='hero-stats'><span><strong>@(Library.Articles.Count - 1)</strong> 篇开发教程</span><span><strong>从零</strong> 开始学习</span><span><strong>C#</strong> 创造无限可能</span></div><div class='hero-art' aria-hidden='true'><span class='pixel-leaf'>✦</span><div class='code-card'><span>// 你的模组，从这里开始</span><br /><b>public class</b> MyFirstMod<br />&#123;<br />　<span>// 把想象变成现实</span><br />&#125;</div></div></section><div class='version-notice'>ⓘ 本教程基于 <strong>.NET 10 + tModLoader 1.4.5</strong>。使用旧版本时，请留意接口与代码差异。</div><section class='learning-path'><div class='section-heading'><div class='eyebrow'>一步一步，循序渐进</div><h2>选择你的学习起点</h2><p>第一次写模组？从环境准备开始。已有基础？直接探索感兴趣的章节。</p></div><div class='chapter-grid'>@{ var number = 0; }@foreach(var group in Library.Groups) { number++; <section class='chapter-card'><div class='chapter-number'>@number.ToString("00") <span>@group.Count() 篇教程</span></div><h3>@group.Key.Replace("——", " · ")</h3><ul>@foreach(var article in group) { <li><a href='@article.Url'>@article.Title <span>→</span></a></li> }</ul><a class='chapter-more' href='@group.First().Url'>进入章节 →</a></section> }</div></section><section class='community'><div><div class='eyebrow'>一起学习，一起创造</div><h2>写代码的路上，你并不孤单。</h2><p>遇到问题、分享作品，或者聊聊你的新点子。</p></div><div class='community-contact'><small>加入教程交流 QQ 群</small><strong>921853970</strong></div></section>
}
</main>
@code {
[SupplyParameterFromQuery(Name = "article")] public string? Article { get; set; }
private Tutorial? Current => Library.Find(Article);
private string query = "";

private string? lastArticle;
private bool enhancePending = true;
private Tutorial? Neighbor(int offset) { var list = Library.Articles.Where(a => a.Title != "主页").ToList(); var index = Current is null ? -1 : list.IndexOf(Current); return index >= 0 && index + offset >= 0 && index + offset < list.Count ? list[index + offset] : null; }
protected override void OnParametersSet() { if(lastArticle != Article) { query = ""; lastArticle = Article; } enhancePending = true; }
protected override async Task OnAfterRenderAsync(bool firstRender) { if(enhancePending || firstRender) { enhancePending = false; await JS.InvokeVoidAsync("tutorialSite.enhance"); } }
private string Snippet(Tutorial article) { var word = query.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? ""; var index = article.SearchText.IndexOf(word, StringComparison.OrdinalIgnoreCase); var start = Math.Max(0, index - 35); return (start > 0 ? "…" : "") + article.SearchText.Substring(start, Math.Min(160, article.SearchText.Length - start)) + "…"; }
}
