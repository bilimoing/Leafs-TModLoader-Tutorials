@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="comments" aria-labelledby="comments-title">
    <h2 id="comments-title">留言</h2>
    <p class="comment-notice">使用 GitHub 登录后即可留言。留言公开保存到 GitHub，提交后直接显示。</p>
    <div @ref="host" class="utterances-host"></div>
    <p class="comment-help">首次登录会前往 GitHub 授权并返回。若评论区未加载，请检查网络或 <a href="@DiscussionUrl" target="_blank" rel="noopener noreferrer">前往 GitHub 查看讨论 ↗</a>。</p>
    @if (loadError) { <p role="alert">评论组件加载失败，请刷新页面重试。</p> }
</section>

@code {
    [Parameter, EditorRequired] public string Article { get; set; } = "";
    private ElementReference host;
    private string? loadedArticle;
    private bool loadError;
    private string DiscussionUrl => "https://github.com/bilimoing/Leafs-TModLoader-Tutorials/issues?q=" + Uri.EscapeDataString("is:issue \"教程留言：" + Article + "\"");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loadedArticle == Article) return;
        loadedArticle = Article;
        try { await JS.InvokeVoidAsync("tutorialComments.mount", host, Article); }
        catch (JSException) { loadError = true; await InvokeAsync(StateHasChanged); }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("tutorialComments.unmount", host); }
        catch (JSException) { }
        catch (OperationCanceledException) { }
    }
}
